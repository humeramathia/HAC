// START OF CODE
// ========================================

// Defense in depth if a client uses the Firestore SDK directly.
// The Android app talks to FastAPI (Admin SDK bypasses these rules).
// Admin is not a custom claim: it is members/{uid}.role == "Admin".

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && memberDoc().role == "Admin";
    }

    function isOwner(memberId) {
      return signedIn() && request.auth.uid == memberId;
    }

    match /members/{userId} {
      allow read: if signedIn() && (isOwner(userId) || isAdmin());
      allow create: if signedIn() && isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    match /memberProfiles/{userId} {
      allow read: if signedIn() && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId) || isAdmin();
    }

    match /events/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /competitions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /resources/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Create checks request.resource (incoming memberId) so a member cannot
    // write a session owned by someone else. Read/update use the stored owner.
    match /scoreSessions/{id} {
      allow read: if signedIn() && (isOwner(resource.data.memberId) || isAdmin());
      allow create: if signedIn() && isOwner(request.resource.data.memberId);
      allow update, delete: if isOwner(resource.data.memberId) || isAdmin();
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && (isOwner(resource.data.memberId) || isAdmin());
      allow create, delete: if isAdmin();
    }
  }
}

// ========================================
// END OF CODE
// ========================================
