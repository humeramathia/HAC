<?xml version="1.0" encoding="utf-8"?>
<!-- Soft outer ring (~2dp) for Login CTA -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#CC528FD0"
                android:startColor="#CC9ABA55"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/habibia_blue"
                android:startColor="@color/habibia_green"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
