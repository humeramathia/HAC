<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Habibia.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                style="@style/Text.Habibia.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saturday Practice" />

            <TextView
                android:id="@+id/subtitleText"
                style="@style/Text.Habibia.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="12 September 2026 · 09:00" />
        </LinearLayout>

        <Button
            android:id="@+id/editButton"
            style="@style/Widget.Habibia.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Edit" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.Habibia.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Delete"
            android:textColor="@color/habibia_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
