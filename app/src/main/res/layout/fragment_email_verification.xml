<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/habibia_background">

    <include layout="@layout/include_edge_decor" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/logo" />

        <TextView
            style="@style/Text.Habibia.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Verify Your Email"
            android:textAlignment="center" />

        <TextView
            style="@style/Text.Habibia.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="We sent a verification link to your email address. Please check your inbox and tap the link to activate your account."
            android:textAlignment="center" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Habibia.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.Habibia.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the email?" />

                <TextView
                    style="@style/Text.Habibia.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Check your spam folder or request a new verification link below." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/verifyButton"
            style="@style/Widget.Habibia.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Resend Verification Email" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
