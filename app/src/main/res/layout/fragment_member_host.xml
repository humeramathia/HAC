<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/habibia_background">

    <FrameLayout
        android:id="@+id/memberTabContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/memberBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/habibia_surface"
        app:menu="@menu/menu_member_bottom"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/habibia_bottom_nav_color"
        app:itemTextColor="@color/habibia_bottom_nav_color" />
</LinearLayout>
