<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingText"
                    style="@style/Text.Habibia.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Good morning, Aaliyah" />

                <TextView
                    style="@style/Text.Habibia.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habibia Archery Club" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/notificationButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_notifications"
                    android:padding="12dp"
                    android:src="@drawable/ic_notifications" />

                <View
                    android:id="@+id/notificationDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_status_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/profileButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_profile"
                android:padding="12dp"
                android:src="@drawable/ic_nav_profile" />
        </LinearLayout>

        <TextView
            style="@style/Text.Habibia.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="NEXT IMPORTANT EVENT"
            android:textAllCaps="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featuredEventCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_featured_event"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/featuredEventTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saturday Practice"
                    android:textColor="@color/habibia_text_on_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/featuredEventDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="12 September 2026"
                    android:textColor="#E6FFFFFF" />

                <TextView
                    android:id="@+id/featuredEventTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="09:00"
                    android:textColor="#E6FFFFFF" />

                <TextView
                    android:id="@+id/featuredEventLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Habibia Archery Club"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Habibia.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:text="PERFORMANCE"
            android:textAllCaps="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/performanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Habibia.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latest" />

                        <TextView
                            android:id="@+id/latestScoreText"
                            style="@style/Text.Habibia.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Habibia.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average" />

                        <TextView
                            android:id="@+id/averageScoreText"
                            style="@style/Text.Habibia.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="78" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Habibia.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Highest" />

                        <TextView
                            android:id="@+id/highestScoreText"
                            style="@style/Text.Habibia.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="81" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miniChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <Button
                    android:id="@+id/viewProgressButton"
                    style="@style/Widget.Habibia.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="View Progress" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Habibia.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:text="UPCOMING COMPETITION"
            android:textAllCaps="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/upcomingCompetitionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/competitionNameText"
                    style="@style/Text.Habibia.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Western Cape Indoor Championships" />

                <TextView
                    android:id="@+id/competitionDateText"
                    style="@style/Text.Habibia.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="15 September 2026" />

                <TextView
                    android:id="@+id/competitionVenueText"
                    style="@style/Text.Habibia.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cape Town" />

                <Button
                    android:id="@+id/viewCompetitionButton"
                    style="@style/Widget.Habibia.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="View Details" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Habibia.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:text="QUICK ACTIONS"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/recordScoreButton"
                style="@style/Widget.Habibia.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Record Score" />

            <Button
                android:id="@+id/calendarButton"
                style="@style/Widget.Habibia.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="View Calendar" />

            <Button
                android:id="@+id/competitionsButton"
                style="@style/Widget.Habibia.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Competitions" />

            <Button
                android:id="@+id/resourcesButton"
                style="@style/Widget.Habibia.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Resources" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
