<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/competitionCard"
    style="@style/Widget.Habibia.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/competitionName"
            style="@style/Text.Habibia.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Western Cape Indoor Championships" />

        <TextView
            android:id="@+id/competitionDate"
            style="@style/Text.Habibia.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="15 September 2026" />

        <TextView
            android:id="@+id/venueText"
            style="@style/Text.Habibia.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cape Town" />

        <TextView
            android:id="@+id/deadlineText"
            style="@style/Text.Habibia.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Deadline: 1 September 2026" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
