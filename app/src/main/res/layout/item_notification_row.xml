<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationCard"
    style="@style/Widget.Habibia.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:id="@+id/unreadDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notificationTitle"
                style="@style/Text.Habibia.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Competition Announced" />

            <TextView
                android:id="@+id/notificationMessage"
                style="@style/Text.Habibia.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Western Cape Indoor Championships registration is now open." />

            <TextView
                android:id="@+id/notificationDate"
                style="@style/Text.Habibia.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2 hours ago" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
