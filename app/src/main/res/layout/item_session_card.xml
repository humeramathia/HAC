<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessionCard"
    style="@style/Widget.Habibia.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sessionTitle"
                style="@style/Text.Habibia.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Practice – 18 m" />

            <TextView
                android:id="@+id/sessionRank"
                style="@style/Text.Habibia.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2ND"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/sessionDate"
            style="@style/Text.Habibia.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12 September 2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Habibia.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score" />

                <TextView
                    android:id="@+id/sessionScore"
                    style="@style/Text.Habibia.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="524 / 600" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Habibia.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average" />

                <TextView
                    android:id="@+id/sessionAverage"
                    style="@style/Text.Habibia.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.73" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sessionMeta"
            style="@style/Text.Habibia.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="60 arrows" />

        <Button
            android:id="@+id/viewDetailsButton"
            style="@style/Widget.Habibia.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="View Details" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
